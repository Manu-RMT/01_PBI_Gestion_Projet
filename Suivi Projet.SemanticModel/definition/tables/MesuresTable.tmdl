		lineageTag: c7533ef3-0bea-425b-aebc-cdcc221ba724

	measure 'Livrables livrés (%)' = DIVIDE([Livrables livrés], [Nombre de livrables])
		lineageTag: b7afc7d8-0126-441c-ac06-6de245e17f6e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Livrables en retard' = ```
			
			VAR d = [Date dernier reporting]
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(FactLivrables[deliverable_id]),
			    ISBLANK(FactLivrables[actual_delivery_date]),
			    FactLivrables[planned_delivery_date] < d
			)
			
			```
		formatString: 0
		lineageTag: 87104299-6124-4c10-9558-f924bb03b863

	measure 'Retard moyen de livraison (jours)' = ```
			
			AVERAGEX(
			    FILTER(
			        FactLivrables,
			        NOT ISBLANK(FactLivrables[actual_delivery_date])
			            && FactLivrables[actual_delivery_date] > FactLivrables[planned_delivery_date]
			    ),
			    DATEDIFF(FactLivrables[planned_delivery_date], FactLivrables[actual_delivery_date], DAY)
			)
			
			
			```
		lineageTag: d880886e-b495-443c-8320-b5aa06b15135

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Livrables acceptés (%)' = ```
			
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT(FactLivrables[deliverable_id]), FactLivrables[accepted_flag] = TRUE()),
			    [Livrables livrés]
			)
			
			
			
			```
		formatString: 0
		lineageTag: 6c970dcc-b0de-4d4c-ab36-a72691801096

	measure 'Impact délai changements en attente (jours)' = ```
			
			CALCULATE(SUM(FactChangements[estimated_delay_days]), FactChangements[status] = "En attente")
			
			```
		formatString: 0
		lineageTag: 69f956db-8cbe-4376-bc8d-de097135ae7a

	measure 'Décisions en attente' = ```
			
			CALCULATE(DISTINCTCOUNT(FactDecisionProjet[decision_id]), FactDecisionProjet[status] = "En attente")
			
			```
		formatString: 0
		lineageTag: 0bd30534-1270-4850-81d0-2adca133f5a8

	measure 'Délai moyen de décision (jours)' = ```
			
			AVERAGEX(
			    FILTER(FactDecisionProjet, NOT ISBLANK(FactDecisionProjet[decision_date])),
			    DATEDIFF(FactDecisionProjet[request_date], FactDecisionProjet[decision_date], DAY)
			)
			
			```
		lineageTag: 86dce0e4-2883-4947-9ced-ccce81f7bc0c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Statut global' =
			
			VAR spi = [SPI - Performance des délais]
			VAR cpi = [CPI - Performance des coûts]
			VAR crit = [Risques critiques ouverts]
			RETURN
			SWITCH(
			    TRUE(),
			    spi < 0.85 || cpi < 0.85 || crit >= 5, "Rouge",
			    spi < 0.95 || cpi < 0.95 || crit >= 3, "Ambre",
			    "Vert"
			)
			
			// ---------- Synthèse : statut global calculé ----------// Idéalement, mets les seuils dans une table de paramètres au lieu de les écrire en dur.
		lineageTag: 70b19fc7-3842-4d70-9dde-dbdde1fdf69e

	measure 'Couleur statut global' =
			
			SWITCH([Statut global], "Rouge", "#D0453D", "Ambre", "#E0A93B", "#2E9F6B")
		lineageTag: ab5e8897-8ff2-4419-97a6-59fbd434ecfd

