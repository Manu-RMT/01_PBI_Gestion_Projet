	measure 'Statut global' = ```
			
			VAR SPI = [SPI - Performance des délais]
			VAR CPI = [CPI - Performance des coûts]
			VAR EAC = [EAC - Coût estimé à terminaison]
			VAR BAC = [BAC - Budget initial]
			VAR Crit = [Risques critiques ouverts]
			VAR Retard = [Tâches en retard]
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    // ROUGE : situation critique
			    SPI < 0.85
			        || CPI < 0.85
			        || Crit >= 10
			        || EAC > BAC * 1.15
			        || Retard >= 10,
			        "#FF0000",
			
			    // AMBRE : situation à surveiller
			    SPI < 0.95
			        || CPI < 0.95
			        || Crit >= 3
			        || EAC > BAC
			        || Retard >= 3,
			        "#FFC000",
			
			    // VERT : situation maîtrisée
			    "#008000"
			)
			
			
			```
		lineageTag: 70b19fc7-3842-4d70-9dde-dbdde1fdf69e

