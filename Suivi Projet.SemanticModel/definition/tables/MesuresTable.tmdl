	measure 'Jalons échus' =
			
			VAR d = [Date dernier reporting]
			RETURN COUNTROWS(FILTER(FactJalons, FactJalons[planned_date] <= d))
		formatString: 0
		lineageTag: 8c113bff-f6c6-4b77-b22d-5a05fdd51dea

	measure 'Jalons respectés' =
			
			VAR d = [Date dernier reporting]
			RETURN
			COUNTROWS(
			    FILTER(
			        FactJalons,
			        FactJalons[planned_date] <= d
			            && NOT ISBLANK(FactJalons[actual_date])
			            && FactJalons[actual_date] <= FactJalons[planned_date]
			    )
			)
		formatString: 0
		lineageTag: 90c112f5-2c9c-4d55-b026-7cf1e660b3e7

	measure 'Jalons respectés (%)' = DIVIDE([Jalons respectés], [Jalons échus])
		lineageTag: 44c8fa12-76e1-431d-ba79-fbde5178ba6d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prochain jalon' =
			
			VAR d = [Date dernier reporting]
			RETURN
			MINX(
			    FILTER(FactJalons, FactJalons[planned_date] >= d && ISBLANK(FactJalons[actual_date])),
			    FactJalons[planned_date]
			)
		formatString: General Date
		lineageTag: 3f5e2d3a-4a13-47ec-a153-0c5b8f7212f9

	measure 'Jours avant le prochain jalon' = DATEDIFF([Date dernier reporting], [Prochain jalon], DAY)
