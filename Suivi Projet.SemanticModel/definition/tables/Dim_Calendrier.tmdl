		annotation SummarizationSetBy = Automatic

	partition Dim_Calendrier = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2015, 1, 1), DATE(2030, 12, 31)),
				    "Année", YEAR([Date]),
				    "Mois Numéro", MONTH([Date]),
				    "Mois", FORMAT([Date], "MMMM", "fr-FR"),
				    "Mois Année", FORMAT([Date], "YYYY-MM"),
				    "Trimestre Numéro", QUARTER([Date]),
				    "Trimestre", "T" & FORMAT([Date], "Q"),
				    "Année Trimestre", YEAR([Date]) & "-T" & FORMAT([Date], "Q"),
				    "Numéro Semaine", WEEKNUM([Date], 2),
				    "Jour Semaine Numéro", WEEKDAY([Date], 2),
				    "Jour Semaine", FORMAT([Date], "dddd", "fr-FR")
				)

	annotation PBI_Id = 3751b625334a48cb9cf3d92e8bc548e8

