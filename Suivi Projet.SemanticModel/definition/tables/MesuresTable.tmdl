	measure 'AC - Coût réel cumulé' =
			
			-- Calcule le coût réel cumulé (AC : Actual Cost)
			-- du portefeuille à partir du dernier snapshot disponible
			-- pour chaque projet.
			-- Évite d'additionner plusieurs snapshots d'un même projet.
			SUMX(
			    VALUES(DimProjet[project_id]),
			
			    -- Identifie le projet traité par l'itération.
			    VAR ProjetCourant = DimProjet[project_id]
			
			    -- Recherche la date du dernier snapshot disponible
			    -- pour ce projet.
			    VAR DernierSnapshot =
			        CALCULATE(
			            MAX(FactPilotageMensuel[snapshot_date]),
			            FactPilotageMensuel[project_id] = ProjetCourant
			        )
			
			    -- Récupère le coût réel cumulé à cette date.
			    RETURN
			        CALCULATE(
			            MAX(FactPilotageMensuel[actual_cost_cumulative_eur]),
			            FactPilotageMensuel[project_id] = ProjetCourant,
			            FactPilotageMensuel[snapshot_date] = DernierSnapshot
			        )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: 3f4b1f12-a793-4ce7-8952-0a0b7cd83bfb

	measure 'ETC - Prévision après date d''état (€)' =
			
			-- Affiche le coût restant estimé uniquement après
			-- la dernière date de suivi réel du projet.
			VAR DateAxe =
			    MAX(Dim_Calendrier[Date])
			VAR DateEtat =
			    CALCULATE(
			        MAX(FactPilotageMensuel[snapshot_date]),
			        REMOVEFILTERS(Dim_Calendrier)
			    )
			VAR CoutRestant =
			    [ETC - Reste à faire estimé (€)]
			RETURN
			    IF(
			        DateAxe > DateEtat,
			        CoutRestant,
			        BLANK()
			    )
		lineageTag: 941335c9-582a-4fdf-a941-00f27617fb07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

