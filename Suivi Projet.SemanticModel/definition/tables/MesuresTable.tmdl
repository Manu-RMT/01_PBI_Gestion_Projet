table MesuresTable
	lineageTag: 10df987b-8ab5-4d21-ad3e-95879c71fe8d

	measure 'Date dernier reporting' = ```
			
			    // Récupère la dernière date de snapshot disponible.
			    // Retire les filtres du calendrier pour éviter qu'une
			    // sélection de date masque le dernier reporting.
			    CALCULATE(
			        MAX(FactPilotageMensuel[snapshot_date]),
			        REMOVEFILTERS(Dim_Calendrier)
			    )
			
			```
		formatString: Short Date
		lineageTag: 83cde7c0-6483-450e-8c4d-486eb5dee52c

	measure 'Avancement réel moyen (%)' = ```
			
			AVERAGE(FactPilotageMensuel[actual_progress_pct])
			 
			```
		lineageTag: 99c43079-e4fa-4835-9c16-64d517e429b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avancement prévu moyen (%)' =
			// Moyenne simple des taux d'avancement planifiés visibles.
			    AVERAGE(FactPilotageMensuel[planned_progress_pct])
		formatString: 0
		lineageTag: 63bab02a-af92-454b-ab9e-178ca99f1880

	measure 'Avancement portefeuille (%)' = ```
			
			-- Avancement réel pondéré par le budget initial.
			-- Retourne une valeur entre 0 et 1, à formater en pourcentage.
			-- Retient le dernier snapshot de chaque projet dans le contexte courant.
			
			VAR ProjetsVisibles =
			    VALUES(DimProjet[project_id])
			
			VAR ValeurPonderee =
			    SUMX(
			        ProjetsVisibles,
			        VAR ProjetCourant = DimProjet[project_id]
			        VAR DernierSnapshot =
			            CALCULATE(
			                MAX(FactPilotageMensuel[snapshot_date]),
			                FactPilotageMensuel[project_id] = ProjetCourant
			            )
			        VAR AvancementProjet =
			            CALCULATE(
			                MAX(FactPilotageMensuel[actual_progress_pct]),
			                FactPilotageMensuel[project_id] = ProjetCourant,
			                FactPilotageMensuel[snapshot_date] = DernierSnapshot
			            )
			        VAR BudgetProjet =
			            CALCULATE(
			                MAX(DimProjet[budget_initial_eur])
			            )
			        RETURN
			            DIVIDE(AvancementProjet, 100) * BudgetProjet
			    )
			
			VAR BudgetTotal =
			    SUMX(
			        ProjetsVisibles,
			        CALCULATE(MAX(DimProjet[budget_initial_eur]))
			    )
			
			RETURN
			    DIVIDE(ValeurPonderee, BudgetTotal)
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: ebb029ea-006e-4f2f-907e-ee24dcc36ddf

	measure 'Avancement prévu portefeuille (%)' =
			
			VAR ProjetsVisibles = VALUES(DimProjet[project_id])
			VAR ValeurPonderee =
			    SUMX(
			        ProjetsVisibles,
			        VAR ProjetCourant = DimProjet[project_id]
			        VAR DernierSnapshot =
			            CALCULATE(
			                MAX(FactPilotageMensuel[snapshot_date]),
			                FactPilotageMensuel[project_id] = ProjetCourant
			            )
			        VAR AvancementProjet =
			            CALCULATE(
			                MAX(FactPilotageMensuel[planned_progress_pct]),
			                FactPilotageMensuel[project_id] = ProjetCourant,
			                FactPilotageMensuel[snapshot_date] = DernierSnapshot
			            )
			        VAR BudgetProjet = CALCULATE(MAX(DimProjet[budget_initial_eur]))
			        RETURN DIVIDE(AvancementProjet, 100) * BudgetProjet
			    )
			VAR BudgetTotal =
			    SUMX(ProjetsVisibles, CALCULATE(MAX(DimProjet[budget_initial_eur])))
			RETURN
			    DIVIDE(ValeurPonderee, BudgetTotal)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 8cd5c2a1-70e9-4997-8dbe-97bb8c826d21

	measure 'Écart avancement (points)' = ```
			
			// Une valeur positive signifie que le réel dépasse le prévisionnel.
			// La mesure renvoie une différence de proportions. 
			100 * [Avancement portefeuille (%)] - [Avancement prévu portefeuille (%)]
			```
		lineageTag: 70ec3613-c7b8-408d-8b05-23f4f548a44f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'BAC - Budget initial' = ```
			
			// Somme les budgets initiaux des projets visibles. 
			// Respecte les filtres et segments du rapport. 
			SUM(DimProjet[budget_initial_eur])
			
			```
		formatString: 0
		lineageTag: 6c22b77d-664a-4b98-865d-5de2f1a9951d

	measure 'Coût réel cumulé' = ```
			
			// Additionne le coût cumulé du dernier snapshot de chaque projet. 
			// Évite de sommer plusieurs snapshots historiques d'un même projet. 
			
			SUMX( VALUES(DimProjet[project_id]), VAR ProjetCourant = DimProjet[project_id] VAR DernierSnapshot = CALCULATE( MAX(FactPilotageMensuel[snapshot_date]), FactPilotageMensuel[project_id] = ProjetCourant ) RETURN CALCULATE( MAX(FactPilotageMensuel[actual_cost_cumulative_eur]), FactPilotageMensuel[project_id] = ProjetCourant, FactPilotageMensuel[snapshot_date] = DernierSnapshot ) )
			
			```
		lineageTag: e520d868-9a63-449a-bce0-7439cd806b12

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PV - Valeur planifiée' = ```
			
			// Additionne la valeur planifiée du dernier snapshot de chaque projet. 
			// PV signifie Planned Value dans la méthode de la valeur acquise. 
			SUMX(
						VALUES(DimProjet[project_id]),
						VAR ProjetCourant = DimProjet[project_id]
						VAR DernierSnapshot = CALCULATE(
							MAX(FactPilotageMensuel[snapshot_date]),
							FactPilotageMensuel[project_id] = ProjetCourant
						)
						RETURN
							CALCULATE(
								MAX(FactPilotageMensuel[planned_value_eur]),
								FactPilotageMensuel[project_id] = ProjetCourant,
								FactPilotageMensuel[snapshot_date] = DernierSnapshot
							)
					)
			```
		lineageTag: a0998ed7-d0b4-451c-8590-1bcd555ec122

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EV - Valeur acquise estimée' = ```
			
			-- Valeur acquise estimée = budget initial × avancement réel.
			[BAC - Budget initial] * [Avancement portefeuille (%)]
			
			```
		lineageTag: 0fec3932-b4c8-4853-833f-3015282df189

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CPI - Performance des coûts' = ```
			// Compare la valeur acquise estimée au coût réel. // CPI inférieur à 1 : performance des coûts défavorable. 
			DIVIDE([EV - Valeur acquise estimée], [Coût réel cumulé])
			
			```
		formatString: 0
		lineageTag: d22bf7b0-9f1a-4b90-9372-8e36c5415d93

	measure 'SPI - Performance des délais' = ```
			
			    // Compare la valeur acquise à la valeur planifiée.
			    // Si > 1 en avance sur le projet
			    DIVIDE(
			        [EV - Valeur acquise estimée],
			        [PV - Valeur planifiée]
			    )
			```
		formatString: 0.00
		lineageTag: 678a3e89-94e8-4804-8770-c484e5031010

	measure 'CV - Écart de coûts' = ```
			
			// Une valeur négative signale un dépassement de coûts. 
			[EV - Valeur acquise estimée] - [Coût réel cumulé]
			```
		lineageTag: 5dc3c5bb-8e37-400f-9397-5c5515cc0d77

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SV - Écart de planning (€)' = ```
			// Une valeur négative indique un retard en valeur budgétaire. 
			[EV - Valeur acquise estimée] - [PV - Valeur planifiée]
			
			```
		lineageTag: ebeb8cb7-472f-4644-b00f-d82eed6364b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EAC - Coût estimé à terminaison' = ```
			
			// Estime le coût final si la performance actuelle se poursuit. 
			// Formule : coût réel + (BAC - EV) / CPI. 
			
			VAR CPIActuel = [CPI - Performance des coûts]
					RETURN
						IF(
							CPIActuel > 0,
							[Coût réel cumulé] + DIVIDE(
								[BAC - Budget initial] - [EV - Valeur acquise estimée],
								CPIActuel
							)
						)
			
			```
		lineageTag: e54f4507-4f3b-410b-8b74-e229fbbf5fb1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'VAC - Écart budgétaire final estimé' = ```
			
			// Une valeur négative suggère un dépassement budgétaire. 
			[BAC - Budget initial] - [EAC - Coût estimé à terminaison]
			
			```
		lineageTag: 7728b9cb-e8df-4cfc-ab7d-a80b7a5d939c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

