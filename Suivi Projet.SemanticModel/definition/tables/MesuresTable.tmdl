	measure 'Risques critiques ouverts' =
			
			VAR NbRisques =
			    CALCULATE(
			        DISTINCTCOUNT(FactRisques[risk_id]),
			        ISBLANK(FactRisques[closed_date]),
			        FactRisques[probability_1_5] >= 4,
			        FactRisques[impact_1_5] >= 4
			    )
			RETURN
			IF(
			    ISINSCOPE(FactRisques[risk_id]),
			    1,
			    NbRisques
			)
		formatString: 0
		lineageTag: bbacfbde-4160-4184-ae20-fc60abef37c9

