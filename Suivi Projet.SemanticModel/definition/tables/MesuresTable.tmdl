	measure 'Date dernier reporting' = ```
			
			    // Récupère la dernière date de snapshot disponible.
			    // Retire les filtres du calendrier pour éviter qu'une
			    // sélection de date masque le dernier reporting.
			    CALCULATE(
			        MAX(FactPilotageMensuel[snapshot_date]),
			        REMOVEFILTERS(Dim_Calendrier)
			    )
			
			```
		formatString: Short Date
		lineageTag: 83cde7c0-6483-450e-8c4d-486eb5dee52c

	measure 'Avancement réel moyen (%)' = ```
			
			AVERAGE(FactPilotageMensuel[actual_progress_pct])
			 
			```
		lineageTag: 99c43079-e4fa-4835-9c16-64d517e429b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avancement prévu moyen (%)' =
			// Moyenne simple des taux d'avancement planifiés visibles.
			    AVERAGE(FactPilotageMensuel[planned_progress_pct])
		formatString: 0
		lineageTag: 63bab02a-af92-454b-ab9e-178ca99f1880

	measure 'Avancement portefeuille (%)' =
			
			-- Calcule l'avancement réel du portefeuille,
			-- pondéré par le budget initial de chaque projet.
			-- Pour chaque projet, retient le dernier snapshot
			-- disponible à la date sélectionnée ou avant celle-ci.
			
			VAR DateSelectionnee =
			    MAX(Dim_Calendrier[Date])
			
			VAR ProjetsVisibles =
			    VALUES(DimProjet[project_id])
			
			VAR ValeurPonderee =
			    SUMX(
			        ProjetsVisibles,
			
			        VAR ProjetCourant =
			            DimProjet[project_id]
			
			        -- Recherche le dernier snapshot du projet
			        -- jusqu'à la date sélectionnée, en ignorant
			        -- le filtre de date appliqué à la table de faits.
			        VAR DernierSnapshot =
			            CALCULATE(
			                MAX(FactPilotageMensuel[snapshot_date]),
			                REMOVEFILTERS(Dim_Calendrier),
			                REMOVEFILTERS(FactPilotageMensuel[snapshot_date]),
			                FactPilotageMensuel[project_id] = ProjetCourant,
			                FactPilotageMensuel[snapshot_date] <= DateSelectionnee
			            )
			
			        -- Récupère l'avancement à ce snapshot.
			        VAR AvancementProjet =
			            CALCULATE(
			                MAX(FactPilotageMensuel[actual_progress_pct]),
			                REMOVEFILTERS(Dim_Calendrier),
			                REMOVEFILTERS(FactPilotageMensuel[snapshot_date]),
			                FactPilotageMensuel[project_id] = ProjetCourant,
			                FactPilotageMensuel[snapshot_date] = DernierSnapshot
			            )
			
			        VAR BudgetProjet =
			            CALCULATE(
			                MAX(DimProjet[budget_initial_eur])
			            )
			
			        RETURN
			            DIVIDE(AvancementProjet, 100) * BudgetProjet
			    )
			
			VAR BudgetTotal =
			    SUMX(
			        ProjetsVisibles,
			        CALCULATE(MAX(DimProjet[budget_initial_eur]))
			    )
			
			RETURN
			    DIVIDE(ValeurPonderee, BudgetTotal)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: ebb029ea-006e-4f2f-907e-ee24dcc36ddf

	measure 'Avancement prévu portefeuille (%)' =
			
			-- Calcule l'avancement prévu du portefeuille,
			-- pondéré par le budget initial de chaque projet.
			-- Pour chaque projet, retient le dernier snapshot
			-- disponible à la date sélectionnée ou avant celle-ci.
			
			VAR DateSelectionnee =
			    MAX(Dim_Calendrier[Date])
			
			VAR ProjetsVisibles =
			    VALUES(DimProjet[project_id])
			
			VAR ValeurPonderee =
			    SUMX(
			        ProjetsVisibles,
			
			        VAR ProjetCourant =
			            DimProjet[project_id]
			
			        -- Recherche le dernier snapshot du projet
			        -- jusqu'à la date sélectionnée, en ignorant
			        -- les filtres de date sur le calendrier et la date de snapshot.
			        VAR DernierSnapshot =
			            CALCULATE(
			                MAX(FactPilotageMensuel[snapshot_date]),
			                REMOVEFILTERS(Dim_Calendrier),
			                REMOVEFILTERS(FactPilotageMensuel[snapshot_date]),
			                FactPilotageMensuel[project_id] = ProjetCourant,
			                FactPilotageMensuel[snapshot_date] <= DateSelectionnee
			            )
			
			        -- Récupère l'avancement prévu à cette date.
			        VAR AvancementProjet =
			            CALCULATE(
			                MAX(FactPilotageMensuel[planned_progress_pct]),
			                REMOVEFILTERS(Dim_Calendrier),
			                REMOVEFILTERS(FactPilotageMensuel[snapshot_date]),
			                FactPilotageMensuel[project_id] = ProjetCourant,
			                FactPilotageMensuel[snapshot_date] = DernierSnapshot
			            )
			
			        -- Récupère le budget initial du projet.
			        VAR BudgetProjet =
			            CALCULATE(
			                MAX(DimProjet[budget_initial_eur])
			            )
			
			        -- Pondère l'avancement prévu par le budget du projet.
			        RETURN
			            DIVIDE(AvancementProjet, 100) * BudgetProjet
			    )
			
			-- Calcule le budget total des projets visibles.
			VAR BudgetTotal =
			    SUMX(
			        ProjetsVisibles,
			        CALCULATE(
			            MAX(DimProjet[budget_initial_eur])
			        )
			    )
			
			-- Retourne une valeur entre 0 et 1, à formater en pourcentage.
			RETURN
			    DIVIDE(ValeurPonderee, BudgetTotal)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 8cd5c2a1-70e9-4997-8dbe-97bb8c826d21

	measure 'Écart avancement (points)' =
			
			// Valeur négative : le réel est en retard sur le prévu
			100 * ([Avancement portefeuille (%)] - [Avancement prévu portefeuille (%)])
		lineageTag: 70ec3613-c7b8-408d-8b05-23f4f548a44f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'BAC - Budget initial' = ```
			
			// Somme les budgets initiaux des projets visibles. 
			// Respecte les filtres et segments du rapport. 
			SUM(DimProjet[budget_initial_eur])
			
			```
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: 6c22b77d-664a-4b98-865d-5de2f1a9951d

	measure 'PV - Valeur planifiée' =
			
			-- Calcule le PV (Planned Value) du portefeuille.
			-- Pour chaque projet, récupère la valeur planifiée
			-- du dernier snapshot disponible dans le contexte courant.
			-- Additionne ensuite les valeurs de tous les projets.
			SUMX(
			    VALUES(DimProjet[project_id]),
			
			    -- Identifie le projet traité par l'itération.
			    VAR ProjetCourant = DimProjet[project_id]
			
			    -- Recherche la date du dernier snapshot disponible
			    -- pour ce projet.
			    VAR DernierSnapshot =
			        CALCULATE(
			            MAX(FactPilotageMensuel[snapshot_date]),
			            FactPilotageMensuel[project_id] = ProjetCourant
			        )
			
			    -- Récupère la valeur planifiée à cette date.
			    RETURN
			        CALCULATE(
			            MAX(FactPilotageMensuel[planned_value_eur]),
			            FactPilotageMensuel[project_id] = ProjetCourant,
			            FactPilotageMensuel[snapshot_date] = DernierSnapshot
			        )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: a0998ed7-d0b4-451c-8590-1bcd555ec122

	measure 'EV - Valeur acquise estimée' = ```
			
			-- Valeur acquise estimée = budget initial × avancement réel.
			-- Calcule la valeur budgétaire du travail réellement réalisé. 
			[BAC - Budget initial] * [Avancement portefeuille (%)]
			
			```
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: 0fec3932-b4c8-4853-833f-3015282df189

	measure 'CPI - Performance des coûts' = ```
			// Compare la valeur acquise estimée au coût réel. // CPI inférieur à 1 : performance des coûts défavorable. 
			DIVIDE([EV - Valeur acquise estimée], [AC - Coût réel cumulé])
			
			```
		formatString: 0.00
		lineageTag: d22bf7b0-9f1a-4b90-9372-8e36c5415d93

	measure 'SPI - Performance des délais' = ```
			
			    // Compare la valeur acquise à la valeur planifiée.
			    // Si > 1 en avance sur le projet
			    DIVIDE(
			        [EV - Valeur acquise estimée],
			        [PV - Valeur planifiée]
			    )
			```
		formatString: 0.00
		lineageTag: 678a3e89-94e8-4804-8770-c484e5031010

	measure 'CV - Écart de coûts' = ```
			
			// Une valeur négative signale un dépassement de coûts. 
			[EV - Valeur acquise estimée] - [AC - Coût réel cumulé]
			```
		lineageTag: 5dc3c5bb-8e37-400f-9397-5c5515cc0d77

