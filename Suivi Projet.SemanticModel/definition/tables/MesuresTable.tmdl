	measure 'Interprétation courbe en S' = ```
			
			VAR EV = [EV - Valeur acquise estimée]
			VAR PV = [PV - Valeur planifiée]
			VAR AC = [AC - Coût réel cumulé]
			
			-- Écarts de délais et de coûts en valeur monétaire.
			VAR EcartDelais = EV - PV
			VAR EcartCouts = EV - AC
			
			-- Indices de performance.
			VAR SPI = DIVIDE(EV, PV)
			VAR CPI = DIVIDE(EV, AC)
			
			RETURN
			    SWITCH(
			        TRUE(),
			
			        ISBLANK(EV) || ISBLANK(PV) || ISBLANK(AC),
			            "Données insuffisantes pour interpréter la courbe.",
			
			        PV = 0 && EV = 0 && AC = 0,
			            "Projet non démarré ou sans données financières.",
			
			        PV = 0,
			            "Valeur planifiée nulle : interprétation des délais impossible.",
			
			        AC = 0 && EV > 0,
			            "Coûts réels nuls malgré un avancement : vérifier les données.",
			
			        SPI < 0.90 && CPI < 0.90,
			            "ALERTE : retard important et dépassement des coûts.",
			
			        SPI < 0.90,
			            "ALERTE : retard important par rapport au planning.",
			
			        CPI < 0.90,
			            "ALERTE : performance des coûts dégradée.",
			
			        SPI < 1 && CPI < 1,
			            "Vigilance : retard et coûts moins performants que prévu.",
			
			        SPI < 1,
			            "Vigilance : avancement inférieur au planning.",
			
			        CPI < 1,
			            "Vigilance : coûts engagés trop élevés par rapport au travail réalisé.",
			
			        SPI >= 1 && CPI >= 1,
			            "Situation favorable : avancement conforme ou en avance et coûts maîtrisés.",
			
			        "Situation à surveiller."
			    )
			
			```
		lineageTag: 75478d59-5fc7-4c5e-9328-c436d3dc211a

