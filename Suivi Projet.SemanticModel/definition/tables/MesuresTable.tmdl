	measure 'Score de risque moyen (ouverts)' = ```
			
			// « Score de risque moyen » inclut les risques clôturés. 
			AVERAGEX(
			    FILTER(FactRisques, ISBLANK(FactRisques[closed_date])),
			    FactRisques[probability_1_5] * FactRisques[impact_1_5]
			)
