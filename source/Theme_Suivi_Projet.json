{
  "name": "Suivi de projet - Bleu gris",
  "dataColors": ["#137C8B", "#709CA7", "#7A90A4", "#B8CBD0", "#344D59", "#2E9F6B", "#E0A93B", "#D0453D"],
  "background": "#FFFFFF",
  "foreground": "#344D59",
  "tableAccent": "#137C8B",
  "good": "#2E9F6B",
  "neutral": "#E0A93B",
  "bad": "#D0453D",
  "maximum": "#137C8B",
  "center": "#9BBAC3",
  "minimum": "#E0EAED",
  "textClasses": {
    "callout": { "fontSize": 34, "fontFace": "Segoe UI Semibold", "color": "#344D59" },
    "title": { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#344D59" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#5A7183" },
    "label": { "fontSize": 11, "fontFace": "Segoe UI", "color": "#3F5866" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#EEF3F5" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#EEF3F5" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#D3DEE2" } }, "radius": 18 }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#344D59" } },
          "fontSize": 14,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }],
        "visualHeader": [{ "show": false }],
        "padding": [{ "top": 12, "bottom": 12, "left": 16, "right": 16 }],
        "dropShadow": [{ "show": false }],
        "categoryAxis": [{
          "labelColor": { "solid": { "color": "#3F5866" } },
          "fontSize": 11,
          "showAxisTitle": false,
          "lineColor": { "solid": { "color": "#D3DEE2" } }
        }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#5A7183" } },
          "fontSize": 11,
          "showAxisTitle": false,
          "gridlineColor": { "solid": { "color": "#D3DEE2" } }
        }],
        "legend": [{ "labelColor": { "solid": { "color": "#3F5866" } }, "fontSize": 11, "position": "Bottom" }],
        "labels": [{ "color": { "solid": { "color": "#344D59" } }, "fontSize": 11, "labelDisplayUnits": 1 }]
      }
    },
    "card": {
      "*": {
        "title": [{ "show": false }],
        "labels": [{
          "color": { "solid": { "color": "#344D59" } },
          "fontSize": 34,
          "fontFamily": "Segoe UI Semibold",
          "labelDisplayUnits": 1
        }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#5A7183" } }, "fontSize": 12 }]
      }
    },
    "cardVisual": {
      "*": {
        "title": [{ "show": false }],
        "value": [{
          "fontColor": { "solid": { "color": "#344D59" } },
          "fontSize": 34,
          "fontFamily": "Segoe UI Semibold",
          "labelDisplayUnits": 1
        }],
        "label": [{ "show": true, "fontColor": { "solid": { "color": "#5A7183" } }, "fontSize": 12 }]
      }
    },
    "kpi": {
      "*": {
        "title": [{ "show": true }],
        "indicator": [{
          "goodColor": { "solid": { "color": "#2E9F6B" } },
          "neutralColor": { "solid": { "color": "#E0A93B" } },
          "badColor": { "solid": { "color": "#D0453D" } },
          "fontSize": 34
        }],
        "trendline": [{ "show": true, "transparency": 80 }]
      }
    },
    "waterfallChart": {
      "*": {
        "sentimentColors": [{
          "increaseFill": { "solid": { "color": "#2E9F6B" } },
          "decreaseFill": { "solid": { "color": "#D0453D" } },
          "otherFill": { "solid": { "color": "#E0A93B" } },
          "totalFill": { "solid": { "color": "#137C8B" } }
        }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#344D59" } }, "background": { "solid": { "color": "#FFFFFF" } } }],
        "items": [{ "fontColor": { "solid": { "color": "#3F5866" } }, "background": { "solid": { "color": "#FFFFFF" } }, "outline": "None" }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#344D59" } },
          "backColor": { "solid": { "color": "#E0EAED" } },
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 12
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#344D59" } },
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "fontColorSecondary": { "solid": { "color": "#344D59" } },
          "backColorSecondary": { "solid": { "color": "#F3F7F8" } },
          "fontSize": 12
        }],
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#D3DEE2" } }
        }],
        "total": [{
          "fontColor": { "solid": { "color": "#344D59" } },
          "backColor": { "solid": { "color": "#E0EAED" } },
          "fontFamily": "Segoe UI Semibold"
        }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#344D59" } },
          "backColor": { "solid": { "color": "#E0EAED" } },
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 12
        }],
        "rowHeaders": [{
          "fontColor": { "solid": { "color": "#344D59" } },
          "backColor": { "solid": { "color": "#FFFFFF" } },
          "fontSize": 12
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#344D59" } },
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "fontColorSecondary": { "solid": { "color": "#344D59" } },
          "backColorSecondary": { "solid": { "color": "#F3F7F8" } },
          "fontSize": 12
        }],
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#D3DEE2" } }
        }]
      }
    },
    "barChart": {
      "*": {
        "valueAxis": [{ "show": false }],
        "labels": [{ "show": true, "labelDisplayUnits": 1 }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "valueAxis": [{ "show": false }],
        "labels": [{ "show": true, "labelDisplayUnits": 1 }]
      }
    },
    "hundredPercentStackedBarChart": {
      "*": {
        "valueAxis": [{ "show": false }],
        "labels": [{ "show": true, "labelDisplayUnits": 1 }]
      }
    },
    "columnChart": {
      "*": {
        "valueAxis": [{ "show": false }],
        "labels": [{ "show": true, "labelDisplayUnits": 1 }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "valueAxis": [{ "show": false }],
        "labels": [{ "show": true, "labelDisplayUnits": 1 }]
      }
    },
    "lineChart": {
      "*": {
        "valueAxis": [{ "show": true, "showAxisTitle": false }],
        "labels": [{ "show": false }],
        "lineStyles": [{ "strokeWidth": 3, "showMarker": false }]
      }
    },
    "areaChart": {
      "*": {
        "valueAxis": [{ "show": true, "showAxisTitle": false }],
        "labels": [{ "show": false }]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "labels": [{ "show": false }],
        "lineStyles": [{ "strokeWidth": 3, "showMarker": false }]
      }
    },
    "donutChart": {
      "*": {
        "legend": [{ "show": true, "position": "Right" }],
        "labels": [{ "show": true, "labelStyle": "Percent of total", "labelDisplayUnits": 1 }]
      }
    },
    "funnel": {
      "*": {
        "labels": [{ "show": true, "labelDisplayUnits": 1 }]
      }
    },
    "gauge": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#344D59" } }, "fontSize": 20 }]
      }
    },
    "scatterChart": {
      "*": {
        "valueAxis": [{ "show": true, "showAxisTitle": true }],
        "categoryAxis": [{ "show": true, "showAxisTitle": true }]
      }
    },
    "shape": {
      "*": {
        "fill": [{ "show": true, "fillColor": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "outline": [{ "show": true, "lineColor": { "solid": { "color": "#D3DEE2" } }, "weight": 1 }],
        "title": [{ "show": false }],
        "border": [{ "show": false }],
        "background": [{ "show": false }]
      }
    },
    "actionButton": {
      "*": {
        "title": [{ "show": false }],
        "border": [{ "show": false }],
        "background": [{ "show": false }]
      }
    },
    "pageNavigator": {
      "*": {
        "title": [{ "show": false }],
        "border": [{ "show": false }],
        "background": [{ "show": false }],
        "fill": [
          { "$id": "default", "show": true, "fillColor": { "solid": { "color": "#FFFFFF" } }, "transparency": 100 },
          { "$id": "hover", "show": true, "fillColor": { "solid": { "color": "#E0EAED" } }, "transparency": 0 },
          { "$id": "selected", "show": true, "fillColor": { "solid": { "color": "#137C8B" } }, "transparency": 0 }
        ],
        "text": [
          { "$id": "default", "show": true, "fontColor": { "solid": { "color": "#3F5866" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold" },
          { "$id": "hover", "show": true, "fontColor": { "solid": { "color": "#344D59" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold" },
          { "$id": "selected", "show": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold" }
        ]
      }
    }
  }
}
