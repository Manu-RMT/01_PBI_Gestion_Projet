	measure 'Contrôle PV vs BAC × prévu' =
			
			[PV - Valeur planifiée] - [BAC - Budget initial] * [Avancement prévu portefeuille (%)]
			// A6. Contrôle de cohérence : PV (planned_value_eur) doit être proche de BAC × avancement prévu.
			//     Un écart important signale deux bases de budget différentes (budget initial et budget à terminaison).
		lineageTag: adee2325-7403-4004-a955-8b858acad328

